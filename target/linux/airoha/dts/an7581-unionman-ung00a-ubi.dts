/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7581.dtsi"

/ {
	model = "Unionman UNG00A (UBI)";
	compatible = "unionman,ung00a-ubi", "airoha,an7581",
		     "airoha,en7581";

	aliases {
		label-mac-device = &gdm1;

		led-boot = &led_power_blue;
		led-failsafe = &led_power_blue;
		led-running = &led_power_blue;
		led-upgrade = &led_power_blue;

		serial0 = &uart1;
	};

	chosen {
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_blue: led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			default-state = "on";
			panic-indicator;
		};

		led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			color = <LED_COLOR_ID_BLUE>;
			function = "phone";
			gpios = <&en7581_pinctrl 24 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	gswp1_led0_pins: gswp1-led0-pins {
		mux {
			function = "phy1_led0";
			pins = "gpio43";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio44";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio45";
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	nand-ecc-engine = <&spi_nand>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0_all {
			label = "ALL";
			reg = <0x0 0x10000000>;
			read-only;
		};

		partition@0 {
			label = "bl2";
			reg = <0x0 0x20000>;
			read-only;
		};

		partition@20000 {
			label = "ubi";
			reg = <0x20000 0xffe0000>;
			compatible = "linux,ubi";

			volumes {
				ubi-vol-fip {
					volname = "fip";
				};

				ubi_fit: ubi-vol-fit {
					volname = "fit";
				};

				ubi_reservedarea: ubi-vol-reservedarea {
					volname = "reservedarea";
				};

				ubi_env: ubi-vol-ubootenv {
					volname = "ubootenv";
				};

				ubi_env2: ubi-vol-ubootenv2 {
					volname = "ubootenv2";
				};
			};
		};
	};
};

&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_reservedarea {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		macaddr_reservedarea_21021: mac-address@21021 {
			compatible = "mac-base";
			reg = <0x21021 0xc>;
			#nvmem-cell-cells = <1>;
		};
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	nvmem-cells = <&macaddr_reservedarea_21021 (0)>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&mdio {
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;

		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000000>;
		reset-deassert-us = <100000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led-0 {
				reg = <0>;
				color = <LED_COLOR_ID_BLUE>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				default-state = "keep";
			};
		};
	};
};

&eth_pcs {
	status = "okay";
};

&gdm4 {
	openwrt,netdev-name = "lan1";
	phy-handle = <&en8811>;
	phy-mode = "2500base-x";
	nvmem-cells = <&macaddr_reservedarea_21021 (0)>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

&gsw_phy1 {
	interrupts = <1>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp1_led0_pins>;
	status = "okay";
};

&gsw_port1 {
	label = "lan4";
	status = "okay";
};

&gsw_phy1_led0 {
	color = <LED_COLOR_ID_BLUE>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	active-low;
	status = "okay";
};

&gsw_phy2 {
	interrupts = <2>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	status = "okay";
};

&gsw_phy2_led0 {
	color = <LED_COLOR_ID_BLUE>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
	status = "okay";
};

&gsw_phy3 {
	interrupts = <3>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
	status = "okay";
};

&gsw_port3 {
	label = "lan2";
	status = "okay";
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_BLUE>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	active-low;
	status = "okay";
};
