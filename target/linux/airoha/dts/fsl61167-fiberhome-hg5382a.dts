/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "fsl61167.dtsi"

/ {
	model = "FiberHome HG5382A";
	compatible = "fiberhome,hg5382a", "airoha,an7581",
		     "airoha,en7581", "freesil,fsl61167";

	aliases {
		label-mac-device = &gdm1;

		led-boot = &led_power_blue;
		led-failsafe = &led_power_blue;
		led-running = &led_power_blue;
		led-upgrade = &led_power_blue;

		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range =
			<0x0 0x80200000 0x0 0x1fe00000>;
		rootdisk = <&ubi_fit>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_blue: led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 13 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 14 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	pnand_pins: pnand-pins {
		mux {
			function = "pnand";
			groups = "pnand";
		};
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&gdm1 {
	nvmem-cells = <&fiberhome_base_mac (1)>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&gdm4 {
	status = "okay";
	phy-handle = <&gpy211>;
	phy-mode = "2500base-x";
	openwrt,netdev-name = "lan1";

	nvmem-cells = <&fiberhome_base_mac (1)>;
	nvmem-cell-names = "mac-address";
};

&mdio {
	gpy211: ethernet-phy@7 {
		compatible = "ethernet-phy-id67c9.de10";
		reg = <7>;
		reset-assert-us = <100000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
	};
};

&pnand_ecc {
	status = "okay";
};

&pnand {
	pinctrl-names = "default";
	pinctrl-0 = <&pnand_pins>;
	status = "okay";

	nand@0 {
		reg = <0>;

		nand-bus-width = <8>;

		nand-ecc-mode = "hw";
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;

		partitions: partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x0 0x20000>;
				read-only;
			};

			partition@20000 {
				label = "ubi";
				reg = <0x20000 0x0>;
				compatible = "linux,ubi";

				volumes {
					ubi_fip: ubi-volume-fip {
						volname = "fip";
					};

					ubi_env: ubi-volume-ubootenv {
						volname = "ubootenv";
					};

					ubi_env2: ubi-volume-ubootenv2 {
						volname = "ubootenv2";
					};

					ubi_factory: ubi-volume-factory {
						volname = "factory";
					};

					ubi_fit: ubi-volume-fit {
						volname = "fit";
					};
				};
			};
		};
	};
};

&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_factory {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		pon_calibration: calibration@0 {
			reg = <0x0 0x800>;
		};

		wifi_eeprom: eeprom@1000 {
			reg = <0x1000 0x1000>;
		};

		fiberhome_base_mac: mac-address@2000 {
			compatible = "mac-base";
			reg = <0x2000 0x6>;
		};

		fiberhome_pon_serial: pon-serial@2010 {
			reg = <0x2010 0x8>;
		};

		fiberhome_device_serial: device-serial@2020 {
			reg = <0x2020 0x20>;
		};
	};
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};
